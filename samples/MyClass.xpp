/// <summary>
/// Sample class to try highlighting and formatting (Shift+Alt+F).
/// </summary>
[ExtensionOf(classStr(SalesFormLetter))]
final class MyClass_Extension {
int counter;
str name = "@SYS12345";

public static void main(Args _args) {
MyClass_Extension obj = new MyClass_Extension();
container con = [1, "two", 3.0];
date d = 31\12\2026;
if(obj.counter==0&&_args!=null){
obj.counter+=1;
} else if (obj.counter > 10) {
throw error(strFmt("Too many: %1", obj.counter));
} else {
info(@"Verbatim ""string""");
}
try {
obj.run( 1 , 2 );
}
catch (Exception::Error) {
/* block
   comment */
retry;
}
}

private void run(int _a, int _b) {
SalesTable salesTable;
select firstonly salesTable
    where salesTable.SalesStatus == SalesStatus::Backorder;
for (int i = 0;i < 10;i++)
    counter++;
}
}
